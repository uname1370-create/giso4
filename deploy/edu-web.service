[Unit]
Description=Education Main Website (سایت اصلی آموزش — پورت 5000)
After=network.target

[Service]
Type=simple
# ── مقادیر مخصوص سرور خود را اینجا تنظیم کنید ──
User=rs2013
Group=rs2013
WorkingDirectory=/home/rs2013/sadeghiai/web
Environment=PYTHONPATH=/home/rs2013/sadeghiai
ExecStart=/home/rs2013/sadeghiai/venv/bin/python -u /home/rs2013/sadeghiai/web/app.py
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
