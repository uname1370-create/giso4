# ⚠️ هشدار: الگوی lib/ در .gitignore ریشهٔ ریپو (مخصوص پایتون) هر پوشهٔ lib/ را
# در کل ریپو نادیده می‌گیرد. کد این وب‌اپ عمداً در src/ است تا هرگز قربانی
# آن الگو نشود. اگر پوشه‌ای به نام lib/ در اینجا ساختید، این خطوط را باز کنید:
# !lib/
# !lib/**

# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# پوشه‌های build و فایل‌های موقت اسکریپت‌های تست (npm run test:chain / test:admin)
/.next-*/
/.tmp-*

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (کلیدهای API هرگز کامیت نشوند)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
