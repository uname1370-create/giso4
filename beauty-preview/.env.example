# ۱) OpenRouter — FLUX.2 Klein 4B image editing
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=black-forest-labs/flux.2-klein-4b
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/images

# ۲) Cloudflare Workers AI — FLUX.2 Klein 4B image editing
