# ---------------------------------------------------------------------------
# نمونهٔ متغیرهای محیطی
# ---------------------------------------------------------------------------

# ۱) Runware
RUNWARE_API_KEY=

# ۲) SiliconFlow
SILICONFLOW_API_KEY=

# ۳) AIMLAPI — image editing
AIMLAPI_API_KEY=

# ۴) Pollinations
POLLINATIONS_API_KEY=

# ۵) رمز ورود پنل مدیریت (/admin)
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# تنظیمات اختیاری
# ---------------------------------------------------------------------------
DEMO_MODE=auto
PROVIDER_TIMEOUT_MS=90000

# AIMLAPI:
# مدل پیش‌فرض image-edit:
# blackforestlabs/flux-2-edit
# AIMLAPI_MODEL=blackforestlabs/flux-2-edit
# AIMLAPI_API_URL=https://api.aimlapi.com/v1/images/generations

# SiliconFlow:
# SILICONFLOW_MODEL=black-forest-labs/FLUX.1-Kontext-dev
# SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1

# Runware:
# RUNWARE_MODELS=runware:108@20,prunaai:2@1,runware:106@1,bfl:3@1
# RUNWARE_API_URL=https://api.runware.ai/v1

# Pollinations:
# POLLINATIONS_MODEL=kontext
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1
