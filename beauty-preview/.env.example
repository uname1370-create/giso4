# ---------------------------------------------------------------------------
# نمونهٔ متغیرهای محیطی — beauty-preview
# فایل واقعی را با نام .env.local بسازید و همین کلیدها را پر کنید.
# اگر کلیدی خالی بماند، آن بخش در «حالت نمایشی» کار می‌کند و برنامه نمی‌خوابد.
# ---------------------------------------------------------------------------

# ۱) Cloudflare Workers AI — هر دو موتور اصلی از همین حساب‌ها استفاده می‌کنند
#   • تحلیل چهره (مشاور ARIA در /api/consult)
#   • رندر پیش‌نمایش (زنجیره /api/generate)
# ترتیب استفاده: حساب ۱ → حساب ۲ → حساب ۳
# وقتی حساب فعلی خطا بدهد/سهمیه‌اش تمام شود، حساب بعدی امتحان می‌شود.
# توکن باید دسترسی Workers AI داشته باشد (داشبورد کلادفلر ← API Tokens).
CLOUDFLARE_API_TOKEN_1=
CLOUDFLARE_ACCOUNT_ID_1=

CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_ACCOUNT_ID_2=

CLOUDFLARE_API_TOKEN_3=
CLOUDFLARE_ACCOUNT_ID_3=

# مدل تحلیل چهره (اختیاری — اگر خالی باشد همین پیش‌فرض استفاده می‌شود)
# CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# مدل رندر نهایی (پیش‌فرض: سریع و کم‌مصرف FLUX.2 Klein 4B)
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# جایگزین فوق‌دقیق ولی پرمصرف (فقط ~۱ تا ۳ رندر رایگان در روز!):
# CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-dev
# مهلت هر حساب کلادفلر به میلی‌ثانیه (پیش‌فرض ۱۵۰۰۰)
# CLOUDFLARE_TIMEOUT_MS=15000
# مهلت سراسری رندر به میلی‌ثانیه (پیش‌فرض ۱۵۰۰۰)
# PROVIDER_TIMEOUT_MS=15000

# ۲) دستیار چت هوشمند (ویجت مشاور در /api/chat)
# بدون کلید، چت‌بات با پاسخ‌های داخلی آماده جواب می‌دهد.
OPENAI_API_KEY=
# مدل چت (اختیاری — پیش‌فرض: gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ۳) Pollinations (اختیاری؛ fallback نهایی رندر اگر هر ۳ حساب کلادفلر fail بدهند)
# کلید با فرمت sk_... از enter.pollinations.ai
# ترتیب زنجیره رندر (پیش‌فرض: cloudflare اول)
# PROVIDER_ORDER=cloudflare,pollinations
POLLINATIONS_API_KEY=
# مدل و آدرس پایه (اختیاری — پیش‌فرض: kontext یعنی FLUX.1 Kontext)
# POLLINATIONS_MODEL=kontext
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1

# ۴) رمز ورود پنل مدیریت (/admin)
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# تنظیمات اختیاری
# ---------------------------------------------------------------------------
# حالت نمایشی: auto (بدون کلید = نمایشی) | on (همیشه نمایشی) | off (همیشه واقعی)
DEMO_MODE=auto
# سقف انتظار هر فراخوانی پروایدر (میلی‌ثانیه)
PROVIDER_TIMEOUT_MS=90000
# مسیر فایل آمار (فقط برای تست؛ پیش‌فرض: data/stats.json کنار اپ)
# STATS_PATH=
