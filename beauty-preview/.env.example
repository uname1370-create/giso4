# ---------------------------------------------------------------------------
# نمونهٔ متغیرهای محیطی — این فایل را کپی کنید و کلیدها را داخل کپی بگذارید:
#
#     cp .env.example .env.local
#
# ⚠️ هرگز فایل حاوی کلید واقعی (.env یا .env.local) را کامیت/پوش نکنید.
# ⚠️ کلیدها فقط سمت سرور خوانده می‌شوند و به مرورگر نمی‌روند.
#
# ترتیب اولویت در Next.js:
#   .env.development.local → .env.local → .env.development → .env
# یعنی اگر متغیری را در .env.local خالی بگذارید، همان مقدار خالی بر .env غلبه
# می‌کند. پس کلیدها را فقط در یک فایل مقدار بدهید.
# ---------------------------------------------------------------------------

# ۱) Runware — https://runware.ai/docs  (غیر OpenAI، آرایهٔ JSON)
RUNWARE_API_KEY=

# ۲) SiliconFlow — http://docs.siliconflow.com/  (Qwen/Qwen-Image-Edit)
SILICONFLOW_API_KEY=

# ۳) AIMLAPI — https://docs.aimlapi.com/  (flux/kontext-pro/image-to-image)
AIMLAPI_API_KEY=

# ۴) Pollinations — https://gen.pollinations.ai/docs  (model: kontext، کلید sk_...)
POLLINATIONS_API_KEY=

# ۵) رمز ورود پنل مدیریت (/admin)
# اگر خالی بماند، رمز پیش‌فرض «1234» استفاده می‌شود — در سرور واقعی حتماً
# یک رمز قوی بگذارید.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# تنظیمات اختیاری
# ---------------------------------------------------------------------------

# حالت نمایشی: auto (پیش‌فرض) = اگر هیچ کلید API تنظیم نشده باشد، پیش‌نمایش
# به‌صورت شبیه‌سازی محلی روی عکس کشیده می‌شود. on = همیشه، off = هرگز.
DEMO_MODE=auto

# مهلت هر پروایدر به میلی‌ثانیه (پیش‌فرض ۹۰۰۰۰)
PROVIDER_TIMEOUT_MS=90000

# تغییر مدل یا آدرس (برای پروکسی/میرور یا تست)
# RUNWARE_MODEL=bfl:flux-1-kontext-pro@1
# RUNWARE_API_URL=https://api.runware.ai/v1
# SILICONFLOW_MODEL=Qwen/Qwen-Image-Edit
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# AIMLAPI_MODEL=flux/kontext-pro/image-to-image
# AIMLAPI_API_URL=https://api.aimlapi.com/v1/images/generations
# POLLINATIONS_MODEL=kontext
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1
