# ---------------------------------------------------------------------------
# نمونهٔ متغیرهای محیطی
# ---------------------------------------------------------------------------

# ۱) Cloudflare Workers AI — FLUX.2 Klein 4B
# ترتیب استفاده: حساب ۱ → حساب ۲ → حساب ۳
# وقتی حساب فعلی خطا بدهد/سهمیه‌اش تمام شود، حساب بعدی امتحان می‌شود.
CLOUDFLARE_API_TOKEN_1=
CLOUDFLARE_ACCOUNT_ID_1=

CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_ACCOUNT_ID_2=

CLOUDFLARE_API_TOKEN_3=
CLOUDFLARE_ACCOUNT_ID_3=

# مدل مشترک هر سه حساب
# CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Moondream/Cloudflare Vision analysis is disabled. The local Vision Engine is used only for brow localization, masking and pixel-preserving compositing.
# ۲) Pollinations (اختیاری؛ fallback نهایی)
POLLINATIONS_API_KEY=

# ۳) رمز ورود پنل مدیریت (/admin)
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# تنظیمات اختیاری
# ---------------------------------------------------------------------------
DEMO_MODE=auto
PROVIDER_TIMEOUT_MS=90000

# Pollinations:
# POLLINATIONS_MODEL=kontext
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1

# ---------------------------------------------------------------------------
# Vision Engine: target-region detection, masking, compositing, validation
VISION_ENGINE_ENABLED=true
VISION_ENGINE_URL=http://127.0.0.1:8010
VISION_ENGINE_TIMEOUT_MS=45000
